.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# IDE 与编辑器的本机项目配置
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace

# 操作系统生成文件
.DS_Store
Thumbs.db
Desktop.ini

